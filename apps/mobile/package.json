{
  "name": "mindshift-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "node ../../scripts/web_copy_ort.mjs && expo export --platform web --output-dir dist",
    "test": "jest"
  },
  "dependencies": {
    "@ai-sdk/provider": "3.0.15",
