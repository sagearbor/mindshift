    "@react-native-google-signin/google-signin": "^16.1.2",
    "expo": "^57.0.0",
    "expo-ai-kit": "0.14.1",
    "expo-application": "~57.0.2",
    "expo-audio": "~57.0.0",
    "expo-auth-session": "~57.0.1",
    "expo-battery": "~57.0.2",
    "expo-build-properties": "~57.0.14",
    "expo-camera": "~57.0.1",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.0",
    "expo-document-picker": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-haptics": "57.0.1",
    "expo-media-library": "~57.0.1",
    "expo-secure-store": "~57.0.0",
    "expo-speech": "~57.0.0",
    "expo-speech-recognition": "56.0.1",
    "expo-updates": "~57.0.8",
    "expo-video": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "firebase": "^12.15.0",
    "onnxruntime-react-native": "1.24.3",
    "onnxruntime-web": "1.24.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webrtc": "^124.0.8",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.1",
    "onnxruntime-node": "1.24.3",
    "react-test-renderer": "19.2.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 30000,
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|zustand)"
    ],
    "setupFiles": [
      "./jest-setup.ts"
    ],
    "moduleNameMapper": {
      "\\.onnx$": "<rootDir>/jest-asset-stub.js"
    }
