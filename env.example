# MindShift server configuration template.
#
# NOTE: this file is intended to live as `.env.example`; it ships as
# `env.example` only because the local agent's permission settings deny
# writing `.env.*` paths. Rename it if you like:  mv env.example .env.example
#
# Copy this file to `.env` at the repo root and uncomment/fill what you need:
#   cp env.example .env
#
# The server loads `.env` on startup (server/main.py). Real environment
# variables ALWAYS take precedence over values in .env. Every variable here
# is optional: with nothing set, the server still runs and honestly reports
# the credential-gated features (LLM, transcription, TTS) as unavailable —
# it never fabricates output.

# ----------------------------------------------------------------------------
# LLM (server/llm_client.py — provider is inferred from MINDSHIFT_MODEL)
# ----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=            # claude-* models (the default)
# OPENAI_API_KEY=               # gpt-* / o1 / o3 / o4 models
# GOOGLE_API_KEY=               # gemini-* models
# MISTRAL_API_KEY=              # mistral-* models

# Model used for suggestions/scoring/insights (default: claude-3-haiku-20240307)
# MINDSHIFT_MODEL=claude-3-haiku-20240307

# ----------------------------------------------------------------------------
# Storage
# ----------------------------------------------------------------------------
# SQLite database path (default: mindshift.db in the working directory)
# MINDSHIFT_DB_PATH=mindshift.db

# ----------------------------------------------------------------------------
# Speech-to-text (STT) provider for the real-time audio pipeline
# ----------------------------------------------------------------------------
# "deepgram" (default) — hosted live streaming STT; needs DEEPGRAM_API_KEY.
# "whisper"            — FREE local transcription via faster-whisper; no key
#                        needed, but the optional dependency must be installed:
#                          pip install -r requirements-whisper.txt
# Unknown values log a warning and fall back to deepgram.
# STT_PROVIDER=deepgram

# Deepgram API key — used for BOTH live transcription and Aura text-to-speech.
# DEEPGRAM_API_KEY=

# Override the Deepgram live WebSocket URL (tests/local fakes only).
# DEEPGRAM_URL=

# Prerecorded-UPLOAD transcription provider (POST /analyze/upload + link/
# chunked paths). Independent of STT_PROVIDER (the live-session switch).
# "deepgram" (default) — hosted; when Deepgram is unavailable AND
#                        faster-whisper is installed, the upload automatically
#                        falls back to local Whisper, surfaced honestly in the
#                        response's transcription_note (never silent).
# "whisper"            — local faster-whisper only; a whisper failure is an
#                        honest error, never a silent fallback to the vendor.
# MINDSHIFT_UPLOAD_STT=deepgram

# Whisper model size for STT_PROVIDER=whisper / MINDSHIFT_UPLOAD_STT=whisper
# (code default: base; the Docker image pre-downloads and defaults to small).
# tiny = fastest / least accurate · base = balanced · small = better accuracy,
# slower · medium = best practical CPU size, slow without a GPU.
# WHISPER_MODEL=base

# ----------------------------------------------------------------------------
# Text-to-speech
# ----------------------------------------------------------------------------
# Recognized but NOT implemented — only Deepgram Aura TTS (DEEPGRAM_API_KEY
# above) is wired up today. Setting these does not enable audio; they are
# documented here for honesty about what the code looks at.
# TTS_API_KEY=
# ELEVENLABS_API_KEY=

# ----------------------------------------------------------------------------
# In-app calls — the TURN relay (server/calls.py)
# ----------------------------------------------------------------------------
# Audio in a call flows peer-to-peer over WebRTC. Google's public STUN is
# always in the list; without a TURN relay two phones both behind carrier-grade
# NAT (the usual case on cellular) may never connect. The Call pre-flight panel
# on the phone says which of those you're in — and
# `GET /calls/ice` reports it from a shell.
#
# Which relay to buy (nothing, ideally — Cloudflare is free to 1,000 GB/month),
# the exact click-paths, and what to paste where:
#   docs/research/turn-options-2026-08-25.md
#
# All of these are read PER REQUEST — no image rebuild, no restart.
#
# The relay URLs, comma-separated (this alone enables TURN):
# MINDSHIFT_TURN_URLS=turn:turn.cloudflare.com:3478?transport=udp,turns:turn.cloudflare.com:5349?transport=tcp
#
# EPHEMERAL credentials (preferred): a shared secret from which the server
# mints a standard TURN REST credential per member, per handout —
#   username   = "<unix-expiry>:<uid>"
#   credential = base64(HMAC-SHA1(secret, username))
# (draft-uberti-behave-turn-rest-00; coturn's `use-auth-secret`). Nobody shares
# a password and a leaked credential expires. Works with coturn and ExpressTURN
# Premium; NOT with Cloudflare/Twilio/Metered, whose credentials are API-minted.
# Takes precedence over the static pair below when both are set.
# MINDSHIFT_TURN_SECRET=
# MINDSHIFT_TURN_REALM=
# Credential lifetime in seconds (default 14400 = 4h, floor 60, cap 86400).
# Must outlive the longest call (MINDSHIFT_CALL_TTL_MINUTES, default 180).
# MINDSHIFT_TURN_TTL_SECONDS=14400
#
# STATIC credentials: one username/password shared by every client, forever.
# The weaker path — use it for vendors that only issue API-minted credentials.
# MINDSHIFT_TURN_USERNAME=
# MINDSHIFT_TURN_CREDENTIAL=

# ----------------------------------------------------------------------------
# Development
# ----------------------------------------------------------------------------
# Set to 1 to force-refresh the on-disk LLM response cache (server/llm_cache.py).
# REFRESH_LLM_CACHE=

# --- In-app calls: TURN relay (optional but strongly recommended) ----------
# Without a relay, two phones on carrier-grade NAT (mobile data) often cannot
# connect. Cloudflare Realtime TURN is free to 1,000 GB/month and mints
# short-lived credentials over its own API — the shared-secret scheme below
# does not apply to it. Dashboard: Realtime -> TURN Server -> Create.
# MINDSHIFT_TURN_KEY_ID=
# MINDSHIFT_TURN_KEY_TOKEN=
# Self-hosted coturn instead? Use the shared-secret path:
# MINDSHIFT_TURN_URLS=turn:example.com:3478?transport=udp
# MINDSHIFT_TURN_SECRET=
# MINDSHIFT_TURN_REALM=
