        {"speaker": "Speaker A", "text_tone": {"warmth": 50, "frustration": 0}, "prosody": {"rms_dbfs": -30.0, "speech_rate": 2.0}},
        {"speaker": "Speaker A", "text_tone": {"warmth": 50, "frustration": 0}, "prosody": {"rms_dbfs": -30.0, "speech_rate": 2.0}},
        {"speaker": "Speaker A", "text_tone": {"warmth": 50, "frustration": 0}, "prosody": {"rms_dbfs": -30.0, "speech_rate": 2.0}},
