{
  "_schema": {
    "version": 1,
    "subject": "The positive nudge detectors D / E / R / K — apps/mobile/src/live/positiveNudges.ts and server/positive_nudges.py",
    "description": "Every nudge that shipped before these was a complaint. D (de-escalated), E (listened), R (repair) and K (calm streak) are the other half of the owner-approved vocabulary (nudge_vocabulary.json). These cases pin WHEN each one fires — and, just as importantly, when it must not: a false 'nice repair!' after something that was not one is worse than saying nothing. Language-neutral: plain field names, seconds as floats.",
    "inputs": {
      "turns": "list of {index, start, end, speaker, is_self, text, loud_level, tone_heat, tone_negativity, cut_in}, in time order. `speaker` is whose voice the loop believes it is (a cluster label or a name); `coalesce_turns` groups consecutive fragments on it, because the live loop's 'turn' is a VAD fragment cut at a 300 ms pause and a sixteen-second monologue arrives as five pieces. Cases here feed already-coalesced TURNS unless the case name says otherwise. `loud_level` is the 0..3 loudness rung the speaker's own baseline put this turn on, or null when loudness could not be measured. `tone_heat` is AGGRESSION — max(frustration, defensiveness) 0..100, or null when the turn was not scored — and is what the SELF side's heat is read from, through the shared >=85/70/50 -> 3/2/1 ladder. `tone_negativity` is NEGATIVE AFFECT — max(frustration, defensiveness, sadness) — and is what R measures the other person's softening on; they are separate numbers because someone you have just shouted at usually goes HURT rather than aggressive, so an aggression-only reading scores a real repair as no change at all. `cut_in` marks a self turn that started inside the previous partner turn and kept going long enough to raise the alert code C.",
      "alert_nudge_times": "session seconds at which ALERT nudges fired; K is the longest gap between them",
      "session_end_s": "when the session stopped, bounding the last calm gap (null: the last turn's end)",
      "cap_s": "optional override of the 120 s positive cap, so a case can exercise it without a five-minute fixture",
      "coalesce": "true = `turns` are FRAGMENTS and the driver must run `coalesce_turns` over them first (the shape a live device actually produces). Absent/false = already-coalesced turns."
    },
    "expected": {
      "nudges": "list of {code, t, turn_index, delivered} in emission order. `delivered: false` = detected but dropped by the cap — still reported, so a replay can show what the user NEARLY felt.",
      "calm": "{longest_s, badge} — K is a summary badge, never a live event, and never a haptic"
    },
    "constants": {
      "listen_min_turn_s": "a partner turn at least this long is one you had to actively let run",
      "deescalation_window_turns": "how many of YOUR turns a de-escalation may take; an unmeasurable turn still spends one",
      "repair_soften_drop": "how far their tone must fall (0..100 points) for 'they softened' to be a measurement",
      "calm_streak_min_s": "no escalation for this long earns the badge",
      "positive_cap_s": "one positive cue per this many seconds, across D/E/R together (nudge_vocabulary.json's `positive_cap_s`)"
    }
  },
  "constants": {
    "listen_min_turn_s": 12.0,
    "deescalation_window_turns": 2,
    "repair_soften_drop": 15,
    "calm_streak_min_s": 300.0,
    "positive_cap_s": 120.0
  },
  "repair_phrases": [
    "im sorry",
    "i am sorry",
    "i apologize",
    "i apologise",
    "my bad",
    "that was on me",
    "youre right",
    "you are right",
    "thats fair",
    "that is fair",
    "fair enough",
    "i hear you",
    "i understand",
    "i get that",
    "that makes sense",
    "i see what you mean",
    "i shouldnt have",
    "i should not have",
    "i didnt mean",
    "i did not mean",
    "let me try again"
  ],
