# Controls what `gcloud run deploy --source .` uploads to Cloud Build.
# Keep secrets OUT of the build upload, and ship only the backend.
# (Without this file gcloud falls back to .gitignore, which does NOT exclude
# every local secret file — e.g. a stray .env2.)

# Secrets — never upload any local env file (values live as Cloud Run env vars).
.env*
!.example.env

# Not needed to build/run the backend image.
apps/
tests/
docs/
tmp/
.git/
.github/
.claude/
node_modules/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.db
*.db-wal
*.db-shm

# Local model caches (gitignored; several GB after the tone evals). We DO ship
# the 84 MB ECAPA ONNX export (the phone's speaker-ID download, served by
# GET /models/ecapa.onnx) so the image is self-sufficient: the Dockerfile only
# pre-exports it when built with the optional torch build-arg, and a plain
# `gcloud builds submit` build has no torch — leaving GET /models/ecapa.onnx to
# 500 and speaker-ID off on the phone (real failure, 2026-08-26). Uploading
# just the .onnx (not the hundreds-of-MB speechbrain checkpoint, nor the 2.9 GB
# tone cache) keeps `gcloud builds submit` fast while making the model present.
server/.ecapa_cache/*
!server/.ecapa_cache/*.onnx
server/.tone_cache/
